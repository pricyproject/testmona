{
  "info": {
    "name": "Import/Export",
    "description": "Data import and export endpoints",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8000",
      "type": "string"
    },
    {
      "key": "accessToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "testProjectId",
      "value": "1",
      "type": "string"
    },
    {
      "key": "idempotencyKey",
      "value": "test-case-import-{{$timestamp}}",
      "type": "string"
    },
    {
      "key": "importJobId",
      "value": "",
      "type": "string"
    }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{accessToken}}",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "Export Test Cases CSV",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/import-export/export/test-cases/?test_suite_id=1&format=csv",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "import-export",
            "export",
            "test-cases"
          ],
          "query": [
            {
              "key": "test_suite_id",
              "value": "1"
            },
            {
              "key": "format",
              "value": "csv"
            }
          ]
        },
        "description": "Export test cases as CSV. The CSV includes import-compatible fields such as reference, row-level section_id, multistep data with step test data/order, timestamps, and suite custom fields when exporting a specific suite."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status code is 200\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test(\"Response includes CSV content\", function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData).to.have.property(\"content\");",
              "    pm.expect(jsonData).to.have.property(\"truncated\");",
              "    pm.expect(jsonData).to.have.property(\"warnings\");",
              "    pm.expect(jsonData.content).to.include(\"title\");",
              "    pm.expect(jsonData.content).to.include(\"section_id\");",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Login - Setup",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"password\": \"demo123\",\n  \"username_or_email\": \"demo@testmona.com\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/token",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "token"
          ]
        },
        "description": "Login to get access token for subsequent requests"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 200\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test(\"Response contains access_token\", function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData).to.have.property('access_token');",
              "    pm.environment.set(\"accessToken\", jsonData.access_token);",
              "    if (jsonData.refresh_token) {",
              "        pm.environment.set(\"refreshToken\", jsonData.refresh_token);",
              "    }",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "Export Data",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"project_id\": {{testProjectId}},\n  \"export_type\": \"test_cases\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/import-export/export",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "import-export",
            "export"
          ]
        },
        "description": "Export data from the system"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 200 or 404\", function () {",
              "    pm.expect([200, 404]).to.include(pm.response.code);",
              "});",
              "",
              "if (pm.response.code === 200) {",
              "    pm.test(\"Response has export data\", function () {",
              "        var jsonData = pm.response.json();",
              "        pm.expect(jsonData).to.be.an('object');",
              "    });",
              "} else {",
              "    pm.test(\"Export endpoint not found - test skipped\", function () {",
              "        console.log(\"Export endpoint not implemented\");",
              "    });",
              "}"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "Import Data",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "multipart/form-data"
          },
          {
            "key": "Idempotency-Key",
            "value": "{{idempotencyKey}}"
          }
        ],
        "body": {
          "mode": "formdata",
          "formdata": [
            {
              "key": "file",
              "type": "file",
              "src": []
            },
            {
              "key": "test_suite_id",
              "value": "1",
              "type": "text"
            },
            {
              "key": "import_mode",
              "value": "skip_duplicates",
              "type": "text"
            }
          ]
        },
        "url": {
          "raw": "{{baseUrl}}/import-export/import/test-cases/",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "import-export",
            "import",
            "test-cases"
          ]
        },
        "description": "Import test cases from CSV. Honors Idempotency-Key, supports import_mode create_only, skip_duplicates, update_existing, create_copy, and matches duplicates by id, reference, external_key, title + section, and title + suite."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 200, 201, or 404\", function () {",
              "    pm.expect([200, 201, 404]).to.include(pm.response.code);",
              "});",
              "",
              "if (pm.response.code === 200 || pm.response.code === 201) {",
              "    pm.test(\"Import successful\", function () {",
              "        var jsonData = pm.response.json();",
              "        pm.expect(jsonData).to.have.property('message');",
              "    });",
              "} else {",
              "    pm.test(\"Import endpoint not found - test skipped\", function () {",
              "        console.log(\"Import endpoint not implemented\");",
              "    });",
              "}"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "Import Previewed Test Cases",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Idempotency-Key",
            "value": "{{idempotencyKey}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"test_suite_id\": 1,\n  \"skip_duplicates\": true,\n  \"duplicate_mode\": \"skip_duplicates\",\n  \"import_mode\": \"skip_duplicates\",\n  \"filename\": \"test-cases.csv\",\n  \"dry_run\": false,\n  \"import_job_id\": \"{{importJobId}}\",\n  \"chunk_index\": 0,\n  \"total_chunks\": 1,\n  \"rows\": [\n    {\n      \"id\": 123,\n      \"row_number\": 2,\n      \"title\": \"Imported login happy path\",\n      \"description\": \"Created from the CSV preview flow\",\n      \"preconditions\": \"User exists and is active\",\n      \"steps\": \"1. Open login page\\n2. Enter valid credentials\\n3. Submit\",\n      \"expected_result\": \"User lands on the dashboard\",\n      \"reference\": \"REQ-123\",\n      \"external_key\": \"EXT-LOGIN-001\",\n      \"priority\": \"medium\",\n      \"test_type\": \"manual\",\n      \"status\": \"active\",\n      \"section_id\": 1,\n      \"order_index\": 1,\n      \"is_multistep\": true,\n      \"multistep_data\": \"[{\\\"step_number\\\":1,\\\"action\\\":\\\"Open login page\\\",\\\"expected_result\\\":\\\"Login form is visible\\\",\\\"step_type\\\":\\\"manual\\\",\\\"data\\\":{\\\"email\\\":\\\"demo@testmona.com\\\"},\\\"order_index\\\":0}]\",\n      \"created_at\": \"2026-05-16T09:00:00\",\n      \"tags\": \"csv,import\",\n      \"import_action\": \"skip_duplicates\",\n      \"duplicate_hint\": true,\n      \"custom_field_values\": []\n    }\n  ]\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/import-export/import/test-cases/previewed",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "import-export",
            "import",
            "test-cases",
            "previewed"
          ]
        },
        "description": "Import mapped test cases. Honors Idempotency-Key, supports import_mode create_only, skip_duplicates, update_existing, create_copy, per-row import_action, chunk metadata, row_results, and duplicate matching by id/reference/external_key/title+section/title+suite."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status code is 200\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test(\"Response includes import counts\", function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData).to.have.property('imported_rows');",
              "    pm.expect(jsonData).to.have.property('total_rows');",
              "    pm.expect(jsonData).to.have.property('errors');",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Create Test Case Import Job",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/import-export/import-jobs",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "import-export",
            "import-jobs"
          ]
        },
        "description": "Create an import job before sending chunked previewed test-case imports.",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"total_rows\": 5000,\n  \"total_chunks\": 10,\n  \"filename\": \"test-cases.csv\"\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status code is successful\", function () {",
              "    pm.expect(pm.response.code).to.be.oneOf([200, 201]);",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Get Test Case Import Job",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/import-export/import-jobs/{{importJobId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "import-export",
            "import-jobs",
            "{{importJobId}}"
          ]
        },
        "description": "Poll import job progress while chunked imports are running."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status code is successful\", function () {",
              "    pm.expect(pm.response.code).to.be.oneOf([200, 201]);",
              "});"
            ]
          }
        }
      ]
    }
  ]
}
