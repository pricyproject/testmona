    {
      "name": "Get Test Case Execution History",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/test-cases/{{testCaseId}}/execution-history?limit=50",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "test-cases",
            "{{testCaseId}}",
            "execution-history"
          ],
          "query": [
            {
              "key": "limit",
              "value": "50"
            }
          ]
        },
        "description": "Get execution history of a test case across test runs with run and executor metadata"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 200, 403, or 404\", function () {",
              "    pm.expect([200, 403, 404]).to.include(pm.response.code);",
              "});",
              "",
              "if (pm.response.code === 200) {",
              "    const jsonData = pm.response.json();",
              "    pm.test(\"Response is an array\", function () {",
              "        pm.expect(jsonData).to.be.an('array');",
              "    });",
              "",
              "    if (jsonData.length > 0) {",
              "        pm.test(\"History item contains enriched fields\", function () {",
              "            pm.expect(jsonData[0]).to.have.property('test_run_id');",
