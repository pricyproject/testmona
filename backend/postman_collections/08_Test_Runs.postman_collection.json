{
  "info": {
    "name": "Test Runs",
    "description": "Test run management endpoints",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8000",
      "type": "string"
    },
    {
      "key": "accessToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "testProjectId",
      "value": "1",
      "type": "string"
    },
    {
      "key": "testSuiteId",
      "value": "1",
      "type": "string"
    },
    {
      "key": "testRunId",
      "value": "1",
      "type": "string"
    },
    {
      "key": "assigneeId",
      "value": "1",
      "type": "string"
    }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{accessToken}}",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "Login - Setup",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"password\": \"demo123\",\n  \"username_or_email\": \"demo@testmona.com\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/token",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "token"
          ]
        },
        "description": "Login to get access token for subsequent requests"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 200\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test(\"Response contains access_token\", function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData).to.have.property('access_token');",
              "    pm.environment.set(\"accessToken\", jsonData.access_token);",
              "    if (jsonData.refresh_token) {",
              "        pm.environment.set(\"refreshToken\", jsonData.refresh_token);",
              "    }",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "Create Test Run",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Test Run 1\",\n  \"description\": \"API-created test run\",\n  \"status\": \"pending\",\n  \"project_id\": {{testProjectId}},\n  \"assigned_to\": {{assigneeId}}\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/test-runs",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "test-runs"
          ]
        },
        "description": "Create a new test run"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 200, 201, or 404 (test suite not found)\", function () {",
              "    pm.expect([200, 201, 404]).to.include(pm.response.code);",
              "});",
              "",
              "if (pm.response.code === 200 || pm.response.code === 201) {",
              "    pm.test(\"Response has id\", function () {",
              "        var jsonData = pm.response.json();",
              "        pm.expect(jsonData).to.have.property('id');",
              "        pm.environment.set(\"testRunId\", jsonData.id);",
              "    });",
              "    ",
              "    pm.test(\"Response has required fields\", function () {",
              "        var jsonData = pm.response.json();",
              "        pm.expect(jsonData).to.have.property('name');",
              "        pm.expect(jsonData).to.have.property('status');",
              "    });",
              "} else {",
              "    pm.test(\"Test suite not found - creation skipped\", function () {",
              "        console.log(\"Test suite ID not set or not found\");",
              "    });",
              "}"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "Get Test Runs",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{baseUrl}}/test-runs?project_id={{testProjectId}}&search={{testRunSearch}}&status={{testRunStatus}}&priority={{testRunPriority}}&assigned_to={{assigneeId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "test-runs"
          ],
          "query": [
            {
              "key": "project_id",
              "value": "{{testProjectId}}"
            },
            {
              "key": "search",
              "value": "{{testRunSearch}}",
              "description": "Optional: search test runs by name or description"
            },
            {
              "key": "status",
              "value": "{{testRunStatus}}",
              "description": "Optional: pending, running, passed, failed, skipped, blocked, completed"
            },
            {
              "key": "priority",
              "value": "{{testRunPriority}}",
              "description": "Optional: low, medium, high, critical"
            },
            {
              "key": "assigned_to",
              "value": "{{assigneeId}}",
              "description": "Optional: assigned user ID"
            }
          ]
        },
        "description": "Get test runs for a project with optional search, status, priority, and assignee filters"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 200 or 404\", function () {",
              "    pm.expect([200, 404]).to.include(pm.response.code);",
              "});",
              "",
              "if (pm.response.code === 200) {",
              "    pm.test(\"Response is array\", function () {",
              "        var jsonData = pm.response.json();",
              "        pm.expect(jsonData).to.be.an('array');",
              "    });",
              "} else {",
              "    pm.test(\"Test suite not found - get test runs skipped\", function () {",
              "        console.log(\"Test suite ID not set or not found\");",
              "    });",
              "}"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "Get Test Run by ID",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{baseUrl}}/test-runs/{{testRunId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "test-runs",
            "{{testRunId}}"
          ]
        },
        "description": "Get a specific test run by ID"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 200 or 404\", function () {",
              "    pm.expect([200, 404]).to.include(pm.response.code);",
              "});",
              "",
              "if (pm.response.code === 200) {",
              "    pm.test(\"Response has id\", function () {",
              "        var jsonData = pm.response.json();",
              "        pm.expect(jsonData).to.have.property('id');",
              "        var testRunId = pm.environment.get(\"testRunId\");",
              "        if (testRunId) {",
              "            pm.expect(jsonData.id.toString()).to.eql(testRunId.toString());",
              "        }",
              "    });",
              "} else {",
              "    pm.test(\"Test run not found - get skipped\", function () {",
              "        console.log(\"Test run ID not set or not found\");",
              "    });",
              "}"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "Update Test Run",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"status\": \"completed\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/test-runs/{{testRunId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "test-runs",
            "{{testRunId}}"
          ]
        },
        "description": "Update a test run"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 200\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test(\"Status updated\", function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData.status).to.eql('completed');",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "Assign Test Run",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"assigned_to\": {{assigneeId}}\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/test-runs/{{testRunId}}/assign",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "test-runs",
            "{{testRunId}}",
            "assign"
          ]
        },
        "description": "Assign a test run to a user and notify the assignee"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 200\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test(\"Assignee updated\", function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData.assigned_to.toString()).to.eql(pm.environment.get(\"assigneeId\") || pm.collectionVariables.get(\"assigneeId\"));",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "Delete Test Run",
      "request": {
        "method": "DELETE",
        "url": {
          "raw": "{{baseUrl}}/test-runs/{{testRunId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "test-runs",
            "{{testRunId}}"
          ]
        },
        "description": "Delete a test run"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 204 or 200\", function () {",
              "    pm.expect([204, 200]).to.include(pm.response.code);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ]
    }
  ]
}
