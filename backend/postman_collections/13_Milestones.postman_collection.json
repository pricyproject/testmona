{
  "info": {
    "name": "Milestones",
    "description": "Milestone endpoints with test-process metrics, linked test plans, execution progress, quality risk, and requirement context.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8000",
      "type": "string"
    },
    {
      "key": "accessToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "testProjectId",
      "value": "1",
      "type": "string"
    },
    {
      "key": "milestoneId",
      "value": "1",
      "type": "string"
    }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{accessToken}}",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "Login - Setup",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"password\": \"demo123\",\n  \"username_or_email\": \"demo@testmona.com\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/token",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "token"
          ]
        },
        "description": "Login to get access token for subsequent requests"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 200\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test(\"Response contains access_token\", function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData).to.have.property('access_token');",
              "    pm.environment.set(\"accessToken\", jsonData.access_token);",
              "    if (jsonData.refresh_token) {",
              "        pm.environment.set(\"refreshToken\", jsonData.refresh_token);",
              "    }",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "Create Milestone",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Regression sign-off v2.4\",\n  \"description\": \"Release milestone for requirements, linked test plans, execution results, and defect triage.\",\n  \"project_id\": {{testProjectId}},\n  \"target_date\": \"2026-06-30T00:00:00Z\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/milestones",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "milestones"
          ]
        },
        "description": "Create a new milestone. The authenticated user is used as created_by."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 200, 201, or 422\", function () {",
              "    pm.expect([200, 201, 422]).to.include(pm.response.code);",
              "});",
              "",
              "if (pm.response.code === 200 || pm.response.code === 201) {",
              "    pm.test(\"Response has id\", function () {",
              "        var jsonData = pm.response.json();",
              "        pm.expect(jsonData).to.have.property('id');",
              "        pm.environment.set(\"milestoneId\", jsonData.id);",
              "    });",
              "    ",
              "    pm.test(\"Response has required fields\", function () {",
              "        var jsonData = pm.response.json();",
              "        pm.expect(jsonData).to.have.property('title');",
              "        pm.expect(jsonData).to.have.property('project_id');",
              "    });",
              "} else {",
              "    pm.test(\"Validation error - creation skipped\", function () {",
              "        console.log(\"Validation error creating milestone\");",
              "    });",
              "}"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "Get Milestones",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{baseUrl}}/milestones?project_id={{testProjectId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "milestones"
          ],
          "query": [
            {
              "key": "project_id",
              "value": "{{testProjectId}}"
            }
          ]
        },
        "description": "Get milestones for a project, including process metrics such as linked test plan count, execution progress, pass rate, open defects, and health."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 200\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test(\"Response is array\", function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData).to.be.an('array');",
              "});",
              "",
              "pm.test(\"Milestone process metrics are present when items exist\", function () {",
              "    var jsonData = pm.response.json();",
              "    if (jsonData.length > 0) {",
              "        pm.expect(jsonData[0]).to.have.property('execution_progress');",
              "        pm.expect(jsonData[0]).to.have.property('health');",
              "        pm.expect(jsonData[0]).to.have.property('linked_test_plans');",
              "    }",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "Update Milestone",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"status\": \"in_progress\",\n  \"progress_percentage\": 35\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/milestones/{{milestoneId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "milestones",
            "{{milestoneId}}"
          ]
        },
        "description": "Update milestone status and manual progress. Completed milestones are returned with process metrics."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 200 or 404\", function () {",
              "    pm.expect([200, 404]).to.include(pm.response.code);",
              "});",
              "",
              "if (pm.response.code === 200) {",
              "    pm.test(\"Status updated\", function () {",
              "        var jsonData = pm.response.json();",
              "        pm.expect(jsonData.status).to.eql('completed');",
              "    });",
              "} else {",
              "    pm.test(\"Milestone not found - update skipped\", function () {",
              "        console.log(\"Milestone ID not set or not found\");",
              "    });",
              "}"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "Get Milestone Stats",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{baseUrl}}/milestones/stats/{{testProjectId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "milestones",
            "stats",
            "{{testProjectId}}"
          ]
        },
        "description": "Get aggregated milestone process statistics for a project."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status code is 200\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test(\"Stats include process totals\", function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData).to.have.property('total');",
              "    pm.expect(jsonData).to.have.property('testPlans');",
              "    pm.expect(jsonData).to.have.property('averageExecutionProgress');",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Get Milestone Test Plans",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{baseUrl}}/milestones/{{milestoneId}}/test-plans",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "milestones",
            "{{milestoneId}}",
            "test-plans"
          ]
        },
        "description": "Get test plans linked to a milestone."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status code is 200 or 404\", function () {",
              "    pm.expect([200, 404]).to.include(pm.response.code);",
              "});",
              "",
              "if (pm.response.code === 200) {",
              "    pm.test(\"Response is array\", function () {",
              "        pm.expect(pm.response.json()).to.be.an('array');",
              "    });",
              "}"
            ]
          }
        }
      ]
    },
    {
      "name": "Delete Milestone",
      "request": {
        "method": "DELETE",
        "url": {
          "raw": "{{baseUrl}}/milestones/{{milestoneId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "milestones",
            "{{milestoneId}}"
          ]
        },
        "description": "Delete a milestone"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 200, 204, or 404\", function () {",
              "    pm.expect([200, 204, 404]).to.include(pm.response.code);",
              "});",
              "",
              "if (pm.response.code === 404) {",
              "    pm.test(\"Milestone not found - delete skipped\", function () {",
              "        console.log(\"Milestone ID not set or not found\");",
              "    });",
              "}"
            ],
            "type": "text/javascript"
          }
        }
      ]
    }
  ]
}
