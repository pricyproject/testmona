{
  "info": {
    "name": "Ask AI",
    "description": "Project-wide Ask AI conversations, sharing, and regeneration endpoints",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8000",
      "type": "string"
    },
    {
      "key": "accessToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "projectId",
      "value": "1",
      "type": "string"
    },
    {
      "key": "conversationId",
      "value": "1",
      "type": "string"
    },
    {
      "key": "conversationPublicId",
      "value": "00000000000000000000000000000000",
      "type": "string"
    },
    {
      "key": "shareRecipientUserId",
      "value": "1",
      "type": "string"
    },
    {
      "key": "shareExpiresAt",
      "value": "2026-12-31T23:59:59Z",
      "type": "string"
    }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{accessToken}}",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "Login - Setup",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username_or_email\": \"demo@testmona.com\",\n  \"password\": \"12345678\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/token",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "token"
          ]
        }
      }
    },
    {
      "name": "List Conversations",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/projects/{{projectId}}/ai/conversations?archived=false",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "projects",
            "{{projectId}}",
            "ai",
            "conversations"
          ],
          "query": [
            {
              "key": "archived",
              "value": "false"
            }
          ]
        }
      }
    },
    {
      "name": "Create Conversation",
      "request": {
        "method": "POST",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/projects/{{projectId}}/ai/conversations",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "projects",
            "{{projectId}}",
            "ai",
            "conversations"
          ]
        }
      }
    },
    {
      "name": "Get Conversation",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/projects/{{projectId}}/ai/conversations/{{conversationId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "projects",
            "{{projectId}}",
            "ai",
            "conversations",
            "{{conversationId}}"
          ]
        }
      }
    },
    {
      "name": "Get Shared Conversation By Link",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/projects/{{projectId}}/ai/conversations/by-link/{{conversationPublicId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "projects",
            "{{projectId}}",
            "ai",
            "conversations",
            "by-link",
            "{{conversationPublicId}}"
          ]
        }
      }
    },
    {
      "name": "Update Conversation Sharing",
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"share_scope\": \"project\",\n  \"share_expires_at\": \"{{shareExpiresAt}}\",\n  \"share_allowed_user_ids\": []\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/projects/{{projectId}}/ai/conversations/{{conversationId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "projects",
            "{{projectId}}",
            "ai",
            "conversations",
            "{{conversationId}}"
          ]
        }
      }
    },
    {
      "name": "Update Conversation Sharing - Restricted",
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"share_scope\": \"restricted\",\n  \"share_expires_at\": \"{{shareExpiresAt}}\",\n  \"share_allowed_user_ids\": [{{shareRecipientUserId}}]\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/projects/{{projectId}}/ai/conversations/{{conversationId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "projects",
            "{{projectId}}",
            "ai",
            "conversations",
            "{{conversationId}}"
          ]
        }
      }
    },
    {
      "name": "Revoke Conversation Sharing",
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"share_scope\": \"private\",\n  \"share_expires_at\": null,\n  \"share_allowed_user_ids\": []\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/projects/{{projectId}}/ai/conversations/{{conversationId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "projects",
            "{{projectId}}",
            "ai",
            "conversations",
            "{{conversationId}}"
          ]
        }
      }
    },
    {
      "name": "Pin Conversation",
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"pinned\": true\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/projects/{{projectId}}/ai/conversations/{{conversationId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "projects",
            "{{projectId}}",
            "ai",
            "conversations",
            "{{conversationId}}"
          ]
        }
      }
    },
    {
      "name": "Ask AI",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"question\": \"Summarize this project\",\n  \"source_types\": [\"requirements\", \"defects\", \"test_plans\", \"test_cases\"]\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/projects/{{projectId}}/ai/ask",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "projects",
            "{{projectId}}",
            "ai",
            "ask"
          ]
        }
      }
    },
    {
      "name": "Regenerate Last Answer",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"source_types\": [\"requirements\", \"defects\", \"test_plans\", \"test_cases\"]\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/projects/{{projectId}}/ai/conversations/{{conversationId}}/regenerate",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "projects",
            "{{projectId}}",
            "ai",
            "conversations",
            "{{conversationId}}",
            "regenerate"
          ]
        }
      }
    },
    {
      "name": "Delete Conversation",
      "request": {
        "method": "DELETE",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/projects/{{projectId}}/ai/conversations/{{conversationId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "projects",
            "{{projectId}}",
            "ai",
            "conversations",
            "{{conversationId}}"
          ]
        }
      }
    }
  ]
}
