          "raw": "{\n  \"project_id\": {{testProjectId}}\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/analytics/coverage-reports/generate",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "analytics",
            "coverage-reports",
