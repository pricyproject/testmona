          "raw": "{{baseUrl}}/analytics/test-activity?project_id={{testProjectId}}&granularity=day",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "analytics",
            "test-activity"
          ],
          "query": [
            {
              "key": "project_id",
              "value": "{{testProjectId}}"
            },
            {
              "key": "granularity",
              "value": "day"
            }
          ]
