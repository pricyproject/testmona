          "raw": "{{baseUrl}}/analytics/traceability-matrix?project_id={{testProjectId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "analytics",
            "traceability-matrix"
          ],
          "query": [
            {
              "key": "project_id",
              "value": "{{testProjectId}}"
            }
          ]
        },
        "description": "Get requirement-to-test-case traceability data shaped for the reports page, including latest execution run IDs."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 200\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "pm.test(\"Response is JSON\", function () {",
              "    pm.response.to.be.json;",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "Coverage Reports",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{baseUrl}}/analytics/coverage-reports?project_id={{testProjectId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "analytics",
            "coverage-reports"
          ],
          "query": [
            {
              "key": "project_id",
