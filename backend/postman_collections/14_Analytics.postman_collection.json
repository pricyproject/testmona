    {
      "name": "Create Shareable Report",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"project_id\": {{testProjectId}},\n  \"title\": \"Executive QA Report\",\n  \"report_type\": \"executive\",\n  \"shared_with\": [\n    \"demo@testmona.com\"\n  ],\n  \"access_level\": \"read-only\",\n  \"expires_in_days\": 30\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/analytics/shareable-reports",
