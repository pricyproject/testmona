# Database Configuration
DATABASE_URL=sqlite:///./test_management.db
# For PostgreSQL use: postgresql+psycopg2://username:password@localhost/dbname
# Production: DATABASE_URL=postgresql+psycopg2://testmona:password@localhost/testmona_prod

# Security - IMPORTANT: Generate a secure random key for production
# Use: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=your-super-secret-key-change-in-production-generate-with-python-secrets-token-urlsafe-32
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS Settings (optional)
ALLOWED_ORIGINS=http://localhost:3000,https://yourdomain.com

# Migration Settings
# Test database for migrations
TEST_DATABASE_URL=sqlite:///./test_test.db
